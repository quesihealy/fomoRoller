[Unit]
Description=FOMO Roller Playback
# Wait for the speaker connect and the ALSA bridge so VLC has an audio sink
After=network.target bluetooth.target sound.target bluealsa.service fomo-bt-connect.service
Wants=bluetooth.target fomo-bt-connect.service

[Service]
# Small settle after the speaker connects so bluealsa exposes its PCM
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/python3 /home/quesihealy/fomo-roller/playback.py
WorkingDirectory=/home/quesihealy/fomo-roller
Restart=always
RestartSec=5
User=quesihealy
Environment=PYTHONUNBUFFERED=1
Environment=FOMO_AUDIO_DIR=/home/quesihealy/audio
# Your Bluetooth speaker's MAC address
Environment=FOMO_BT_MAC=XX:XX:XX:XX:XX:XX

[Install]
WantedBy=multi-user.target
