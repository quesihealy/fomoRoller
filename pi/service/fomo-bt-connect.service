[Unit]
Description=Connect the FOMO Roller Bluetooth speaker (retry until ready)
After=bluetooth.target
Wants=bluetooth.target
Before=fomo-roller.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Set this to your speaker's MAC (same value as in fomo-roller.service)
Environment=FOMO_BT_MAC=XX:XX:XX:XX:XX:XX
ExecStart=/bin/bash /home/quesihealy/fomo-roller/bt_connect.sh

[Install]
WantedBy=multi-user.target
